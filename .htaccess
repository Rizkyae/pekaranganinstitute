# Konfigurasi keamanan untuk server Apache. Vercel memakai vercel.json.

# 1. Nonaktifkan index browsing direktori
Options -Indexes
DirectoryIndex index.html

# 2. Lindungi berkas tersembunyi (dotfiles: .git, .env, .htaccess, dll.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Lindungi berkas sensitif dari akses URL langsung (.sql, .json, .md, .log, .ini)
<FilesMatch "(?i)\.(sql|log|ini|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Blokir akses langsung ke direktori internal
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|database|docs)(/.*)?$ - [F,L]
</IfModule>
